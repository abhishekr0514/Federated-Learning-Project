# MedShield-FL Environment Configuration Example
# Copy this file to .env and configure local environment variables.

# Core System
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION

# Security & JWT
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# POSTGRES_* are authoritative; the app builds DATABASE_URL from these (safe for special characters).
POSTGRES_USER=medshield_admin
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medshield_fl_db
# Optional legacy variable (ignored if POSTGRES_* are set): DATABASE_URL is assembled at startup.

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Federated Learning Configuration (Flower)
FLOWER_SERVER_ADDRESS=127.0.0.1:8080
FLOWER_NUM_ROUNDS=10
FLOWER_MIN_FIT_CLIENTS=2
FLOWER_MIN_AVAILABLE_CLIENTS=2
# FL runner does not auto-start training (use: py -m fl.runner readiness)
FL_RUNNER_AUTO_START=false
FL_ARTIFACT_ROOT=data/processed/federated

# Differential Privacy
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_CLIP_NORM=1.0

# Paths Configuration
DATA_DIR=./data
MODEL_DIR=./models
INFERENCE_ENABLED=false
