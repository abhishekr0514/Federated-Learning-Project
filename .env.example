# MedShield-FL Environment Configuration Example
# Copy this file to .env and configure local environment variables.

# Core System
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION

# Security & JWT
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL) — POSTGRES_* are authoritative (DATABASE_URL is rebuilt at startup).
POSTGRES_USER=medshield_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_MATCH_YOUR_LOCAL_ROLE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medshield_fl_db
# One-time role sync (do not commit): POSTGRES_SUPERUSER_PASSWORD for scripts/bootstrap_postgres_dev_role.py

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Federated Learning Configuration (Flower)
FLOWER_SERVER_ADDRESS=127.0.0.1:8080
FLOWER_NUM_ROUNDS=10
FLOWER_MIN_FIT_CLIENTS=2
FLOWER_MIN_AVAILABLE_CLIENTS=2
# FL runner does not auto-start training (use: py -m fl.runner readiness)
FL_RUNNER_AUTO_START=false
FL_ARTIFACT_ROOT=data/processed/federated

# Differential Privacy
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_CLIP_NORM=1.0

# Paths Configuration
DATA_DIR=./data
MODEL_DIR=./models
INFERENCE_ENABLED=false

# ECG + clinical report fusion (Path A)
ECG_REPORT_MODEL_DIR=models/ecg_report_fusion
ECG_REPORT_INFERENCE_ENABLED=true

# Two-modality GAT fusion (Path B) — enable only after verify_gat_forward_pass.py passes
FUSION_MODEL_DIR=models/gat_ecg_report
FUSION_INFERENCE_ENABLED=false
